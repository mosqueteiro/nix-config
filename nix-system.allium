-- allium: 3
-- nix-system.allium

-- Scope: NixOS/home-manager configuration for frameworkDesktop.
-- This spec tracks domain-level configuration outcomes, not Nix implementation details.

external entity NixInput {
    name: String
}

entity HostConfig {
    name: String
    system: String
    aspects: Set<String>
}

entity UserConfig {
    name: String
    extra_groups: Set<String>
}

entity AIService {
    name: String
    enabled: Boolean
    runtime: String
    models: Set<String>
}

entity AmdNpuConfig {
    enabled: Boolean
    enable_npu: Boolean
    enable_fastflow_lm: Boolean
    enable_lemonade: Boolean
    enable_rocm: Boolean
    enable_vulkan: Boolean
    enable_image_gen: Boolean
}

entity LemonadeService {
    enabled: Boolean
    user: String
    host: String
    port: Integer
    desktop_app: Boolean
}

entity NixSettings {
    experimental_features: Set<String>
    substituters: Set<String>
    trusted_public_keys: Set<String>
}

entity InputFollow {
    key: String
    target: String
}

rule BootstrapFrameworkDesktop {
    when: BootstrapFrameworkDesktop()

    ensures: HostConfig.created(
        name: "frameworkDesktop",
        system: "x86_64-linux",
        aspects: { "gaming", "ai", "lemonade", "local-pkgs" }
    )
    ensures: UserConfig.created(
        name: "mosqueteiro",
        extra_groups: { "networkmanager", "wheel", "video", "render" }
    )
}

rule ConfigureAIStack {
    when: ConfigureAIStack()

    ensures: AIService.created(
        name: "ollama",
        enabled: true,
        runtime: "rocm",
        models: { "gemma4:e4b", "gemma4:26b", "gemma4:31b", "qwen3-coder-next" }
    )
    ensures: AIService.created(
        name: "open-webui",
        enabled: true,
        runtime: "rocm",
        models: { }
    )
}

rule ConfigureLemonadeStack {
    when: ConfigureLemonadeStack()

    ensures: AmdNpuConfig.created(
        enabled: true,
        enable_npu: true,
        enable_fastflow_lm: false,
        enable_lemonade: true,
        enable_rocm: true,
        enable_vulkan: true,
        enable_image_gen: false
    )
    ensures: LemonadeService.created(
        enabled: true,
        user: "mosqueteiro",
        host: "localhost",
        port: 13305,
        desktop_app: false
    )
    ensures: NixSettings.created(
        experimental_features: { "nix-command", "flakes" },
        substituters: { "https://nix-amd-ai.cachix.org" },
        trusted_public_keys: { "nix-amd-ai.cachix.org-1:F4OU4vw/lV2oiG6SBHZ+nqjl4EFJuqI4X9A7pvaBmhQ=" }
    )
}

rule WireNixAmdAiInputs {
    when: WireNixAmdAiInputs()

    ensures: NixInput.created(name: "nix-amd-ai")
    ensures: NixInput.created(name: "nix-amd-ai-flake-parts")
    ensures: NixInput.created(name: "nix-amd-ai-nix-darwin")
    ensures: NixInput.created(name: "nix-amd-ai-nixpkgs-lib")

    ensures: InputFollow.created(
        key: "nix-amd-ai.inputs.flake-parts.follows",
        target: "nix-amd-ai-flake-parts"
    )
    ensures: InputFollow.created(
        key: "nix-amd-ai.inputs.nix-darwin.follows",
        target: "nix-amd-ai-nix-darwin"
    )
    ensures: InputFollow.created(
        key: "nix-amd-ai-flake-parts.inputs.nixpkgs-lib.follows",
        target: "nix-amd-ai-nixpkgs-lib"
    )
}
